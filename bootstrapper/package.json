{
  "name": "mzzplork-bootstrapper",
  "version": "0.1.0",
  "private": true,
  "description": "MzzPlork bootstrapper UI (Electron + Vue) - checks installation, manages MzzPlork Application Data, and launches MzzPlorkClient.exe",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "package": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "build": {
    "appId": "com.mzzplork.bootstrapper",
    "productName": "MzzPlork",
    "directories": {
      "output": "C:\\Users\\kosor\\AppData\\Local\\Temp\\mzzplork-package-output"
    },
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "MzzPlork.${ext}"
    }
  }
}
